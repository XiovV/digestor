# digestor reads .env from the working directory. Variables already set in
# the environment take precedence over this file.

# Comma- or newline-separated list of feed URLs. Optional when the
# environment file has advisories; at least one source is required.
RSS_FEEDS=https://feeds.feedburner.com/TheHackersNews,https://www.bleepingcomputer.com/feed/

# Path to the environment YAML (the -env flag overrides it).
DIGESTOR_ENV_FILE=environment.yaml
# Only consider items published within this window (Go duration).
DIGESTOR_LOOKBACK=24h

# Optional GitHub token for the advisory queries. Without it the GitHub API
# allows 60 requests an hour; with it, 5000. No scopes are needed.
GITHUB_TOKEN=

# Claude Code CLI.
CLAUDE_BIN=claude
CLAUDE_MODEL=
CLAUDE_TIMEOUT=10m

# Email: enabled when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Discord: enabled when DISCORD_WEBHOOK_URL is set.
DISCORD_WEBHOOK_URL=

# Gotify: enabled when GOTIFY_URL is set.
GOTIFY_URL=
GOTIFY_TOKEN=
GOTIFY_PRIORITY=5
