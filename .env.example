# digestor reads .env from the working directory. Variables already set in
# the environment take precedence over this file.

# Feed URLs and advisory queries are set in the environment YAML.

# Path to the environment YAML (the -env flag overrides it).
DIGESTOR_ENV_FILE=environment.yaml
# State file: the last successful run and every digested item. Must be on
# persistent storage (in a k8s CronJob, a volume), or every run is a first run.
DIGESTOR_STATE=digestor-state.json
# Each run fetches items published since the last successful run minus the
# overlap, which catches items that appear in a feed after their publish date.
# The first run fetches the overlap alone. Go durations; there is no "d" unit.
DIGESTOR_OVERLAP=48h
# How far back a run fetches at most, after a long stretch of failed runs.
DIGESTOR_MAX_WINDOW=168h

# Optional GitHub token for the advisory queries. Without it the GitHub API
# allows 60 requests an hour; with it, 5000. No scopes are needed.
GITHUB_TOKEN=

# Claude Code CLI.
CLAUDE_BIN=claude
CLAUDE_MODEL=
CLAUDE_TIMEOUT=10m

# Email: enabled when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Discord: enabled when DISCORD_WEBHOOK_URL is set.
DISCORD_WEBHOOK_URL=

# Gotify: enabled when GOTIFY_URL is set.
GOTIFY_URL=
GOTIFY_TOKEN=
GOTIFY_PRIORITY=5
